FROM debian:bullseye-slim

# Install dependencies
RUN apt-get update -y
RUN apt-get install -y \
    curl \
    tar 

# Download and install Salmon
RUN cd /opt/  \
    &&  /usr/bin/curl -k -L --output salmon-1.5.2_linux_x86_64.tar.gz https://github.com/COMBINE-lab/salmon/releases/download/v1.5.2/salmon-1.5.2_linux_x86_64.tar.gz \
    && tar -xvzf salmon-1.5.2_linux_x86_64.tar.gz

# Set the PATH environment variable
ENV PATH="/opt/salmon-1.5.2_linux_x86_64/bin:$PATH"
